# PostgreSQL/Neon Database URL
DATABASE_URL=postgresql://user:password@host:5432/portfolio_db

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_SESSION_SECRET=generate_a_long_random_secret
ADMIN_SESSION_TTL_MINUTES=10

# Server
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=https://your-portfolio.vercel.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SITE_ICON_URL=

# Optional Cloudinary asset naming
CLOUDINARY_SITE_ICON_NAME=portfolio.png

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
